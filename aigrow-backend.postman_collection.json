{
  "info": {
    "name": "AI-Grow Backend API",
    "description": "Collection tổng hợp API: health, users/session, account/change-password, companies, workspaces, uploads.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8088", "type": "string" },
    { "key": "jwtToken", "value": "YOUR_JWT_TOKEN_HERE", "type": "string" },
    { "key": "companyId", "value": "", "type": "string" },
    { "key": "workspaceId", "value": "", "type": "string" },
    { "key": "uploadBucket", "value": "company-logo", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Auth & Account",
      "item": [
        {
          "name": "POST /api/session (get current user)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ],
            "url": { "raw": "{{baseUrl}}/api/session", "host": ["{{baseUrl}}"], "path": ["api", "session"] }
          }
        },
        {
          "name": "POST /api/account/change-password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"old-pass\",\n  \"newPassword\": \"new-pass\",\n  \"accessToken\": \"COGNITO_ACCESS_TOKEN_IF_REQUIRED\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/account/change-password", "host": ["{{baseUrl}}"], "path": ["api", "account", "change-password"] }
          }
        }
      ]
    },
    {
      "name": "Companies",
      "item": [
        {
          "name": "POST /api/companies (Create)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Company\",\n  \"logoUrl\": \"https://example.com/logo.png\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/companies", "host": ["{{baseUrl}}"], "path": ["api", "companies"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const r = pm.response.json();",
                  "  pm.collectionVariables.set('companyId', r.id || pm.collectionVariables.get('companyId'));",
                  "  console.log('companyId =', pm.collectionVariables.get('companyId'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/companies/{id}",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ],
            "url": { "raw": "{{baseUrl}}/api/companies/{{companyId}}", "host": ["{{baseUrl}}"], "path": ["api", "companies", "{{companyId}}"] }
          }
        },
        {
          "name": "PUT /api/companies/{id}",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Company\",\n  \"logoUrl\": \"https://example.com/logo2.png\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/companies/{{companyId}}", "host": ["{{baseUrl}}"], "path": ["api", "companies", "{{companyId}}"] }
          }
        },
        {
          "name": "PATCH /api/companies/{id}",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Patched Name\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/companies/{{companyId}}", "host": ["{{baseUrl}}"], "path": ["api", "companies", "{{companyId}}"] }
          }
        },
        {
          "name": "GET /api/companies (list by current user)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ],
            "url": {
              "raw": "{{baseUrl}}/api/companies?q=&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "companies"],
              "query": [ {"key":"q","value":""}, {"key":"page","value":"0"}, {"key":"size","value":"10"} ]
            }
          }
        },
        {
          "name": "DELETE /api/companies/{id}",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ],
            "url": { "raw": "{{baseUrl}}/api/companies/{{companyId}}", "host": ["{{baseUrl}}"], "path": ["api", "companies", "{{companyId}}"] }
          }
        },
        {
          "name": "GET /api/companies/admin/all",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ],
            "url": { "raw": "{{baseUrl}}/api/companies/admin/all?page=0&size=10", "host": ["{{baseUrl}}"], "path": ["api", "companies", "admin", "all"], "query": [ {"key":"page","value":"0"}, {"key":"size","value":"10"} ] }
          }
        }
      ]
    },
    {
      "name": "Workspaces",
      "item": [
        {
          "name": "POST /api/workspaces (Create)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"companyId\": \"{{companyId}}\",\n  \"name\": \"Test Workspace\",\n  \"description\": \"This is a test workspace\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/workspaces", "host": ["{{baseUrl}}"], "path": ["api", "workspaces"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const r = pm.response.json();",
                  "  pm.collectionVariables.set('workspaceId', r.id || pm.collectionVariables.get('workspaceId'));",
                  "  console.log('workspaceId =', pm.collectionVariables.get('workspaceId'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/workspaces/{id}",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ],
            "url": { "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}", "host": ["{{baseUrl}}"], "path": ["api", "workspaces", "{{workspaceId}}"] }
          }
        },
        {
          "name": "PUT /api/workspaces/{id}",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Test Workspace\",\n  \"description\": \"Updated desc\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}", "host": ["{{baseUrl}}"], "path": ["api", "workspaces", "{{workspaceId}}"] }
          }
        },
        {
          "name": "DELETE /api/workspaces/{id}",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ],
            "url": { "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}", "host": ["{{baseUrl}}"], "path": ["api", "workspaces", "{{workspaceId}}"] }
          }
        },
        {
          "name": "PATCH /api/workspaces/{id}/restore",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ],
            "url": { "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}/restore", "host": ["{{baseUrl}}"], "path": ["api", "workspaces", "{{workspaceId}}", "restore"] }
          }
        },
        {
          "name": "GET /api/workspaces (by companyId)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ],
            "url": {
              "raw": "{{baseUrl}}/api/workspaces?companyId={{companyId}}&q=&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspaces"],
              "query": [ {"key":"companyId","value":"{{companyId}}"}, {"key":"q","value":""}, {"key":"page","value":"0"}, {"key":"size","value":"10"} ]
            }
          }
        },
        {
          "name": "GET /api/workspaces/company/{companyId} (paged)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ],
            "url": {
              "raw": "{{baseUrl}}/api/workspaces/company/{{companyId}}?q=&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspaces", "company", "{{companyId}}"],
              "query": [ {"key":"q","value":""}, {"key":"page","value":"0"}, {"key":"size","value":"10"} ]
            }
          }
        },
        {
          "name": "GET /api/workspaces/company/{companyId}/all",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ],
            "url": { "raw": "{{baseUrl}}/api/workspaces/company/{{companyId}}/all", "host": ["{{baseUrl}}"], "path": ["api", "workspaces", "company", "{{companyId}}", "all"] }
          }
        },
        {
          "name": "GET /api/workspaces/company/{companyId}/count",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ],
            "url": { "raw": "{{baseUrl}}/api/workspaces/company/{{companyId}}/count", "host": ["{{baseUrl}}"], "path": ["api", "workspaces", "company", "{{companyId}}", "count"] }
          }
        },
        {
          "name": "POST /api/workspaces/companies/{companyId} (Create in company)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"WS in company\",\n  \"description\": \"desc\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/workspaces/companies/{{companyId}}", "host": ["{{baseUrl}}"], "path": ["api", "workspaces", "companies", "{{companyId}}"] }
          }
        },
        {
          "name": "PUT /api/workspaces/companies/{companyId}/{id}",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"WS updated in company\",\n  \"description\": \"desc2\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/workspaces/companies/{{companyId}}/{{workspaceId}}", "host": ["{{baseUrl}}"], "path": ["api", "workspaces", "companies", "{{companyId}}", "{{workspaceId}}"] }
          }
        },
        {
          "name": "DELETE /api/workspaces/companies/{companyId}/{id}",
          "request": {
            "method": "DELETE",
            "header": [ { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ],
            "url": { "raw": "{{baseUrl}}/api/workspaces/companies/{{companyId}}/{{workspaceId}}", "host": ["{{baseUrl}}"], "path": ["api", "workspaces", "companies", "{{companyId}}", "{{workspaceId}}"] }
          }
        }
      ]
    },
    {
      "name": "Uploads",
      "item": [
        {
          "name": "POST /api/uploads/{bucket} (multipart)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/uploads/{{uploadBucket}}", "host": ["{{baseUrl}}"], "path": ["api", "uploads", "{{uploadBucket}}"] }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Gợi ý bucket: company-logo, user-avatar, temp"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
