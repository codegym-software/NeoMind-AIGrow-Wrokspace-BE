      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test script",
          "console.log('📊 Response status:', pm.response.code);",
          "console.log('⏱️ Response time:', pm.response.responseTime + 'ms');",
          "",
          "// Auto-save IDs from responses",
          "if (pm.response.code >= 200 && pm.response.code < 300) {",
          "  try {",
          "    const json = pm.response.json();",
          "    if (json.id) {",
          "      const url = pm.request.url.toString();",
          "      if (url.includes('/companies') && !url.includes('/members') && !url.includes('/roles')) {",
          "        pm.collectionVariables.set('companyId', json.id);",
          "        console.log('✅ Company ID auto-saved:', json.id);",
          "      } else if (url.includes('/workspaces') && !url.includes('/members') && !url.includes('/projects')) {",
          "        pm.collectionVariables.set('workspaceId', json.id);",
          "        console.log('✅ Workspace ID auto-saved:', json.id);",
          "      } else if (url.includes('/projects')) {",
          "        pm.collectionVariables.set('projectId', json.id);",
          "        console.log('✅ Project ID auto-saved:', json.id);",
          "      } else if (url.includes('/roles')) {",
          "        pm.collectionVariables.set('roleId', json.id);",
          "        console.log('✅ Role ID auto-saved:', json.id);",
          "      }",
          "    }",
          "  } catch (e) {",
          "    // Response is not JSON, ignore",
          "  }",
          "}"
        ]
      }
    }
