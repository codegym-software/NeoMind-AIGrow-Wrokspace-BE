{
  "info": {
    "name": "NeoMind Backend API - Fixed Collection",
    "description": "Fixed Postman collection for NeoMind Backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8088",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "companyId",
      "value": "",
      "type": "string"
    },
    {
      "key": "workspaceId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "User & Account",
      "item": [
        {
          "name": "POST /api/session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "session"]
            }
          }
        },
        {
          "name": "POST /api/account/change-password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"old-password\",\n  \"newPassword\": \"new-password\",\n  \"accessToken\": \"COGNITO_ACCESS_TOKEN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/account/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "account", "change-password"]
            }
          }
        }
      ]
    },
    {
      "name": "Company Management",
      "item": [
        {
          "name": "POST /api/companies",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Company\",\n  \"logoUrl\": \"https://example.com/logo.png\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/companies",
              "host": ["{{baseUrl}}"],
              "path": ["api", "companies"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const response = pm.response.json();",
                  "  pm.collectionVariables.set('companyId', response.id);",
                  "  console.log('Company ID saved:', response.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/companies/{id}",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/companies/{{companyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "companies", "{{companyId}}"]
            }
          }
        },
        {
          "name": "GET /api/companies",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/companies?q=&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "companies"],
              "query": [
                {
                  "key": "q",
                  "value": ""
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Workspace Management",
      "item": [
        {
          "name": "POST /api/companies/{companyId}/workspaces",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Workspace\",\n  \"description\": \"This is a test workspace\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/companies/{{companyId}}/workspaces",
              "host": ["{{baseUrl}}"],
              "path": ["api", "companies", "{{companyId}}", "workspaces"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const response = pm.response.json();",
                  "  pm.collectionVariables.set('workspaceId', response.id);",
                  "  console.log('Workspace ID saved:', response.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/workspaces/{id}",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspaces", "{{workspaceId}}"]
            }
          }
        },
        {
          "name": "GET /api/companies/{companyId}/workspaces",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/companies/{{companyId}}/workspaces?q=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "companies", "{{companyId}}", "workspaces"],
              "query": [
                {
                  "key": "q",
                  "value": ""
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Workspace Members",
      "item": [
        {
          "name": "GET /api/workspaces/{workspaceId}/members",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}/members",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspaces", "{{workspaceId}}", "members"]
            }
          }
        },
        {
          "name": "POST /api/workspaces/{workspaceId}/members",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"USER_ID_TO_ADD\",\n  \"roleId\": 201\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}/members",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspaces", "{{workspaceId}}", "members"]
            }
          }
        }
      ]
    },
    {
      "name": "Project Management",
      "item": [
        {
          "name": "POST /api/workspaces/{workspaceId}/projects",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Project\",\n  \"description\": \"This is a test project\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}/projects",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspaces", "{{workspaceId}}", "projects"]
            }
          }
        },
        {
          "name": "GET /api/workspaces/{workspaceId}/projects",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}/projects?includeArchived=false&q=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspaces", "{{workspaceId}}", "projects"],
              "query": [
                {
                  "key": "includeArchived",
                  "value": "false"
                },
                {
                  "key": "q",
                  "value": ""
                }
              ]
            }
          }
        }
      ]
    }
  ]
}