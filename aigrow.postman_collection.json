            { "name": "GET /api/workspaces/{id}", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ], "url": { "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}", "host": ["{{baseUrl}}"], "path": ["api", "workspaces", "{{workspaceId}}"] } } },
            { "name": "PUT /api/workspaces/{id}", "request": { "method": "PUT", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Test Workspace\",\n  \"description\": \"Updated desc\"\n}" }, "url": { "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}", "host": ["{{baseUrl}}"], "path": ["api", "workspaces", "{{workspaceId}}"] } } },
            { "name": "DELETE /api/workspaces/{id}", "request": { "method": "DELETE", "header": [ { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ], "url": { "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}", "host": ["{{baseUrl}}"], "path": ["api", "workspaces", "{{workspaceId}}"] } } },
            { "name": "PATCH /api/workspaces/{id}/restore", "request": { "method": "PATCH", "header": [ { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ], "url": { "raw": "{{baseUrl}}/api/workspaces/{{workspaceId}}/restore", "host": ["{{baseUrl}}"], "path": ["api", "workspaces", "{{workspaceId}}", "restore"] } } },
