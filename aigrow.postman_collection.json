            { "name": "POST /api/workspaces/companies/{companyId} (Create in company)", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ], "body": { "mode": "raw", "raw": "{\n  \"name\": \"WS in company\",\n  \"description\": \"desc\"\n}" }, "url": { "raw": "{{baseUrl}}/api/workspaces/companies/{{companyId}}", "host": ["{{baseUrl}}"], "path": ["api", "workspaces", "companies", "{{companyId}}"] } } },
