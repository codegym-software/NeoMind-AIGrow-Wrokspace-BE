            { "name": "GET /api/workspaces/company/{companyId} (paged)", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ], "url": { "raw": "{{baseUrl}}/api/workspaces/company/{{companyId}}?q=&page=0&size=10", "host": ["{{baseUrl}}"], "path": ["api", "workspaces", "company", "{{companyId}}"], "query": [ {"key":"q","value":""}, {"key":"page","value":"0"}, {"key":"size","value":"10"} ] } } },
