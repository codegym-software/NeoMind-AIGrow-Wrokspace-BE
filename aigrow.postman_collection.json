{
  "info": {
    "name": "AI-Grow (Backend + Cognito)",
    "description": "Collection hợp nhất: Cognito Auth (lấy token) và Backend API (sử dụng token).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8088", "type": "string" },
    { "key": "jwtToken", "value": "YOUR_JWT_TOKEN_HERE", "type": "string" },
    { "key": "companyId", "value": "", "type": "string" },
    { "key": "workspaceId", "value": "", "type": "string" },
    { "key": "projectId", "value": "", "type": "string" },
    { "key": "roleId", "value": "", "type": "string" },
    { "key": "memberUserId", "value": "", "type": "string" },
    { "key": "uploadBucket", "value": "company-logo", "type": "string" },

    { "key": "cognitoBaseUrl", "value": "https://YOUR_DOMAIN.auth.YOUR_REGION.amazoncognito.com", "type": "string" },
    { "key": "clientId", "value": "YOUR_CLIENT_ID", "type": "string" },
    { "key": "clientSecret", "value": "", "type": "string" },
    { "key": "username", "value": "", "type": "string" },
    { "key": "password", "value": "", "type": "string" },
    { "key": "scope", "value": "openid email phone profile", "type": "string" }
  ],
  "item": [
    {
      "name": "Cognito Auth",
      "item": [
        {
          "name": "Password Grant (Public Client)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/x-www-form-urlencoded" } ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "client_id", "value": "{{clientId}}", "type": "text" },
                { "key": "username", "value": "{{username}}", "type": "text" },
                { "key": "password", "value": "{{password}}", "type": "text" },
                { "key": "scope", "value": "{{scope}}", "type": "text" }
              ]
            },
            "url": { "raw": "{{cognitoBaseUrl}}/oauth2/token", "host": ["{{cognitoBaseUrl}}"], "path": ["oauth2", "token"] },
            "description": "Dùng khi app client KHÔNG có client secret (public). Nếu client có secret, dùng request bên dưới."
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "let token = '';",
              "try { const json = pm.response.json(); token = json.id_token || json.access_token; } catch(e) {}",
              "if (token) {",
              "  pm.globals.set('jwtToken', token);",
              "  pm.environment.set('jwtToken', token);",
              "  pm.collectionVariables.set('jwtToken', token);",
              "  console.log('jwtToken set');",
              "} else { console.warn('No token in response'); }"
            ] } }
          ]
        },
        {
          "name": "Password Grant (Confidential Client)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
              { "key": "Authorization", "value": "Basic {{basicAuth}}" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password", "type": "text" },
                { "key": "username", "value": "{{username}}", "type": "text" },
                { "key": "password", "value": "{{password}}", "type": "text" },
                { "key": "scope", "value": "{{scope}}", "type": "text" }
              ]
            },
            "url": { "raw": "{{cognitoBaseUrl}}/oauth2/token", "host": ["{{cognitoBaseUrl}}"], "path": ["oauth2", "token"] },
            "description": "Dùng khi app client CÓ client secret (confidential). Header Authorization = Basic base64(clientId:clientSecret)."
          },
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "const id = pm.collectionVariables.get('clientId') || pm.variables.get('clientId');",
              "const sec = pm.collectionVariables.get('clientSecret') || pm.variables.get('clientSecret');",
              "if (sec) { pm.variables.set('basicAuth', btoa(id + ':' + sec)); } else { pm.variables.unset('basicAuth'); }"
            ] } },
            { "listen": "test", "script": { "exec": [
              "let token = '';",
              "try { const json = pm.response.json(); token = json.id_token || json.access_token; } catch(e) {}",
              "if (token) {",
              "  pm.globals.set('jwtToken', token);",
              "  pm.environment.set('jwtToken', token);",
              "  pm.collectionVariables.set('jwtToken', token);",
              "  console.log('jwtToken set');",
              "} else { console.warn('No token in response'); }"
            ] } }
          ]
        },
        {
          "name": "Client Credentials (optional)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
              { "key": "Authorization", "value": "Basic {{basicAuth}}" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials", "type": "text" },
                { "key": "scope", "value": "{{scope}}", "type": "text" }
              ]
            },
            "url": { "raw": "{{cognitoBaseUrl}}/oauth2/token", "host": ["{{cognitoBaseUrl}}"], "path": ["oauth2", "token"] },
            "description": "Yêu cầu app client có secret và được bật client_credentials trong Cognito."
          },
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "const id = pm.collectionVariables.get('clientId') || pm.variables.get('clientId');",
              "const sec = pm.collectionVariables.get('clientSecret') || pm.variables.get('clientSecret');",
              "if (sec) { pm.variables.set('basicAuth', btoa(id + ':' + sec)); } else { pm.variables.unset('basicAuth'); }"
            ] } },
            { "listen": "test", "script": { "exec": [
              "let token = '';",
              "try { const json = pm.response.json(); token = json.access_token; } catch(e) {}",
              "if (token) {",
              "  pm.globals.set('jwtToken', token);",
              "  pm.environment.set('jwtToken', token);",
              "  pm.collectionVariables.set('jwtToken', token);",
              "  console.log('jwtToken set');",
              "} else { console.warn('No token in response'); }"
            ] } }
          ]
        }
      ]
    },
    {
      "name": "Backend",
      "item": [
        {
          "name": "Health",
          "item": [
            { "name": "GET /health", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] } } }
          ]
        },
        {
          "name": "Auth & Account",
          "item": [
            { "name": "POST /api/session (get current user)", "request": { "method": "POST", "header": [ { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ], "url": { "raw": "{{baseUrl}}/api/session", "host": ["{{baseUrl}}"], "path": ["api", "session"] } } },
            { "name": "POST /api/account/change-password", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ], "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"old-pass\",\n  \"newPassword\": \"new-pass\",\n  \"accessToken\": \"COGNITO_ACCESS_TOKEN_IF_REQUIRED\"\n}" }, "url": { "raw": "{{baseUrl}}/api/account/change-password", "host": ["{{baseUrl}}"], "path": ["api", "account", "change-password"] } } }
          ]
        },
        {
          "name": "Companies",
          "item": [
            { "name": "POST /api/companies (Create)", "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test Company\",\n  \"logoUrl\": \"https://example.com/logo.png\"\n}" }, "url": { "raw": "{{baseUrl}}/api/companies", "host": ["{{baseUrl}}"], "path": ["api", "companies"] } }, "event": [ { "listen": "test", "script": { "exec": [ "if (pm.response.code === 201) {", "  const r = pm.response.json();", "  pm.collectionVariables.set('companyId', r.id || pm.collectionVariables.get('companyId'));", "  console.log('companyId =', pm.collectionVariables.get('companyId'));", "}" ] } } ] },
            { "name": "GET /api/companies/{id}", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ], "url": { "raw": "{{baseUrl}}/api/companies/{{companyId}}", "host": ["{{baseUrl}}"], "path": ["api", "companies", "{{companyId}}"] } } },
            { "name": "PUT /api/companies/{id}", "request": { "method": "PUT", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Company\",\n  \"logoUrl\": \"https://example.com/logo2.png\"\n}" }, "url": { "raw": "{{baseUrl}}/api/companies/{{companyId}}", "host": ["{{baseUrl}}"], "path": ["api", "companies", "{{companyId}}"] } } },
            { "name": "PATCH /api/companies/{id}", "request": { "method": "PATCH", "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Patched Name\"\n}" }, "url": { "raw": "{{baseUrl}}/api/companies/{{companyId}}", "host": ["{{baseUrl}}"], "path": ["api", "companies", "{{companyId}}"] } } },
            { "name": "GET /api/companies (list by current user)", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ], "url": { "raw": "{{baseUrl}}/api/companies?q=&page=0&size=10", "host": ["{{baseUrl}}"], "path": ["api", "companies"], "query": [ {"key":"q","value":""}, {"key":"page","value":"0"}, {"key":"size","value":"10"} ] } } },
            { "name": "DELETE /api/companies/{id}", "request": { "method": "DELETE", "header": [ { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ], "url": { "raw": "{{baseUrl}}/api/companies/{{companyId}}", "host": ["{{baseUrl}}"], "path": ["api", "companies", "{{companyId}}"] } } },
            { "name": "GET /api/companies/admin/all", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ], "url": { "raw": "{{baseUrl}}/api/companies/admin/all?page=0&size=10", "host": ["{{baseUrl}}"], "path": ["api", "companies", "admin", "all"], "query": [ {"key":"page","value":"0"}, {"key":"size","value":"10"} ] } } }
          ]
        },
        {
          "name": "Workspaces",
