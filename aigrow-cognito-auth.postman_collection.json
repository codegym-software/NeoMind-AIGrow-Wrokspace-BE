{
  "info": {
    "name": "AI-Grow Cognito Auth",
    "description": "Lấy token từ AWS Cognito (password grant và client_credentials). Sau khi lấy, test script sẽ set jwtToken vào Globals để dùng chung ở các collection khác.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "cognitoBaseUrl", "value": "https://YOUR_DOMAIN.auth.YOUR_REGION.amazoncognito.com", "type": "string" },
    { "key": "clientId", "value": "YOUR_CLIENT_ID", "type": "string" },
    { "key": "clientSecret", "value": "", "type": "string" },
    { "key": "username", "value": "", "type": "string" },
    { "key": "password", "value": "", "type": "string" },
    { "key": "scope", "value": "openid email phone profile", "type": "string" }
  ],
  "item": [
    {
      "name": "Password Grant (Public Client)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "grant_type", "value": "password", "type": "text" },
            { "key": "client_id", "value": "{{clientId}}", "type": "text" },
            { "key": "username", "value": "{{username}}", "type": "text" },
            { "key": "password", "value": "{{password}}", "type": "text" },
            { "key": "scope", "value": "{{scope}}", "type": "text" }
          ]
        },
        "url": { "raw": "{{cognitoBaseUrl}}/oauth2/token", "host": ["{{cognitoBaseUrl}}"], "path": ["oauth2", "token"] },
        "description": "Dùng khi app client KHÔNG có client secret (public). Nếu client có secret, dùng request bên dưới."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let token = '';",
              "try { const json = pm.response.json(); token = json.id_token || json.access_token; } catch(e) {}",
              "if (token) {",
              "  pm.globals.set('jwtToken', token);",
              "  pm.environment.set('jwtToken', token);",
              "  pm.collectionVariables.set('jwtToken', token);",
              "  console.log('jwtToken set');",
              "} else {",
              "  console.warn('No token in response');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Password Grant (Confidential Client)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
          { "key": "Authorization", "value": "Basic {{basicAuth}}" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "grant_type", "value": "password", "type": "text" },
            { "key": "username", "value": "{{username}}", "type": "text" },
            { "key": "password", "value": "{{password}}", "type": "text" },
            { "key": "scope", "value": "{{scope}}", "type": "text" }
          ]
        },
        "url": { "raw": "{{cognitoBaseUrl}}/oauth2/token", "host": ["{{cognitoBaseUrl}}"], "path": ["oauth2", "token"] },
        "description": "Dùng khi app client CÓ client secret (confidential). Header Authorization = Basic base64(clientId:clientSecret)."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const id = pm.collectionVariables.get('clientId') || pm.variables.get('clientId');",
              "const sec = pm.collectionVariables.get('clientSecret') || pm.variables.get('clientSecret');",
              "if (sec) { pm.variables.set('basicAuth', btoa(id + ':' + sec)); } else { pm.variables.unset('basicAuth'); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "let token = '';",
              "try { const json = pm.response.json(); token = json.id_token || json.access_token; } catch(e) {}",
              "if (token) {",
              "  pm.globals.set('jwtToken', token);",
              "  pm.environment.set('jwtToken', token);",
              "  pm.collectionVariables.set('jwtToken', token);",
              "  console.log('jwtToken set');",
              "} else {",
              "  console.warn('No token in response');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Client Credentials (optional)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/x-www-form-urlencoded" },
          { "key": "Authorization", "value": "Basic {{basicAuth}}" }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            { "key": "grant_type", "value": "client_credentials", "type": "text" },
            { "key": "scope", "value": "{{scope}}", "type": "text" }
          ]
        },
        "url": { "raw": "{{cognitoBaseUrl}}/oauth2/token", "host": ["{{cognitoBaseUrl}}"], "path": ["oauth2", "token"] },
        "description": "Yêu cầu app client có secret và được bật client_credentials trong Cognito."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const id = pm.collectionVariables.get('clientId') || pm.variables.get('clientId');",
              "const sec = pm.collectionVariables.get('clientSecret') || pm.variables.get('clientSecret');",
              "if (sec) { pm.variables.set('basicAuth', btoa(id + ':' + sec)); } else { pm.variables.unset('basicAuth'); }"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "let token = '';",
              "try { const json = pm.response.json(); token = json.access_token; } catch(e) {}",
              "if (token) {",
              "  pm.globals.set('jwtToken', token);",
              "  pm.environment.set('jwtToken', token);",
              "  pm.collectionVariables.set('jwtToken', token);",
              "  console.log('jwtToken set');",
              "} else {",
              "  console.warn('No token in response');",
              "}"
            ]
          }
        }
      ]
    }
  ]
}

