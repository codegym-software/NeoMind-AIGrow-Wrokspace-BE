# ===========================================
# AWS Cognito Configuration
# ===========================================
# Lấy từ AWS Cognito User Pool
ISSUER_URI=https://cognito-idp.ap-southeast-2.amazonaws.com/ap-southeast-2_XXXXXXXXX
CLIENT_ID=your-cognito-client-id
AWS_REGION=ap-southeast-2

# ===========================================
# Application Configuration
# ===========================================
PORT=8088
FRONTEND_ORIGIN=http://localhost:3000
MAX_UPLOAD_SIZE=10MB
PUBLIC_FILES_BASE_URL=http://localhost:8088/files
FILE_STORAGE_BASE=./uploads

# ===========================================
# Database Configuration (for production)
# ===========================================
DB_URL=jdbc:mysql://localhost:3306/ai_grow
DB_USERNAME=root
DB_PASSWORD=your-password

# ===========================================
# Email Configuration (Optional)
# ===========================================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=YOUR_APP_PASSWORD
